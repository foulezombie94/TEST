{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/vendmoi.apk",
      "destination": "https://media.githubusercontent.com/media/foulezombie94/TEST/main/vendmoi.apk",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://media.githubusercontent.com/media/foulezombie94/TEST/main/vendmoi.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}